# Fedora MinGW toolchain with a plain pkg-config: point PKG_CONFIG_LIBDIR at
# the Windows prefixes (see packaging/windows) instead of the sysroot wrapper.

[binaries]
c = 'x86_64-w64-mingw32-gcc'
cpp = 'x86_64-w64-mingw32-g++'
fortran = 'x86_64-w64-mingw32-gfortran'
rust = ['rustc', '--target', 'x86_64-pc-windows-gnu']
ar = '/usr/bin/x86_64-w64-mingw32-ar'
pkg-config = 'pkg-config'
ranlib = '/usr/bin/x86_64-w64-mingw32-ranlib'
strip = '/usr/bin/x86_64-w64-mingw32-strip'
windres = '/usr/bin/x86_64-w64-mingw32-windres'
dlltool = '/usr/bin/x86_64-w64-mingw32-dlltool'
libgcrypt-config = '/usr/x86_64-w64-mingw32/sys-root/mingw/bin/libgcrypt-config'
glib-mkenums = '/usr/bin/glib-mkenums'
glib-compile-resources = '/usr/bin/glib-compile-resources'
glib-genmarshal = '/usr/bin/glib-genmarshal'
glib-compile-schemas = '/usr/bin/glib-compile-schemas'

[properties]
root = '/usr/x86_64-w64-mingw32/sys-root/mingw'
needs_exe_wrapper = true

[host_machine]
system = 'windows'
cpu_family = 'x86_64'
cpu = 'x86_64'
endian = 'little'
