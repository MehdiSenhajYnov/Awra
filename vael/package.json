{
  "name": "vael",
  "version": "1.0.0",
  "description": "Vael — action-exploration 2D",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "desktop": "npm run build && electron .",
    "package": "npm run build && electron-builder --dir"
  },
  "build": {
    "appId": "com.vael.game",
    "productName": "Vael",
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": "dir",
      "icon": "dist/icon.png"
    },
    "win": {
      "target": "dir",
      "icon": "dist/icon.png"
    },
    "mac": {
      "target": "dir",
      "icon": "dist/icon.png"
    }
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "pixi-filters": "^6.1.5",
    "pixi.js": "^8.22.0"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
