using Gtk 4.0;
using Awra 1.0;

Awra.Page example_page {
  max-content-width: 880;

  child: Box page_content {
    orientation: vertical;
    spacing: 24;

    Awra.PageHeader {
      title: "Built with Awra and Blueprint";
      subtitle: "Typed page structure with framework-owned spacing";
    }

    Awra.Section {
      title: "Actions";
      description: "Sections separate content without manufacturing cards";

      child: Awra.Button {
        label: "Accessible GTK action";
      };
    }

    Awra.FilterBar {
      search: Awra.SearchEntry {
        placeholder-text: "Search documents";
      };

      [filter]
      Awra.Button {
        label: "All types";
      }

      summary: Label {
        label: "12 results";
      };
    }

    Awra.Form {
      [row]
      Awra.FormRow {
        label: "Workspace name";
        help-text: "Shown to collaborators";
        control: Awra.Entry {};
      }
    }
  };
}
